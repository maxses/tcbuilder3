#------------------------------------------------------------------------------
#
# \brief		TCBuilder3 script for creating pkg-config and pkg-config-files
#
#           URL: http://pkg-config.freedesktop.org/releases
#
#				Some packages do not support pkg-config. This script helps to create
#				pkg-config these files
#
#  \author  Maximilian Seesslen <src@seesslen.net>
#  \date    <20160116> file created
#
#-------------------.----------------------------------------------------------


vpath		%.pkg-config_file				$(DONE_PATH)


pkg-config.VERSION         =0.29.2
pkg-config.ARCHIVE_FILE    =pkg-config-$(pkg-config.VERSION).tar.gz
pkg-config.ARCHIVE_URL     =http://pkg-config.freedesktop.org/releases/$(pkg-config.ARCHIVE_FILE)
pkg-config.SOURCE_PATH     =pkg-config-$(pkg-config.VERSION)

$(eval $(call Package,pkg-config))

TARGET_PKG_CONFIG_PATH		=$(TARGET_PATH)/lib/pkgconfig
TARGET_PKG_CONFIG_RUNTIME	=$(HOST_PATH)/bin/pkg-config
TARGET_PKG_CONFIG_FILE		=$(TARGET_PKG_CONFIG_PATH)/$(if $($*.PKG_CONFIG_FILE),$($*.PKG_CONFIG_FILE).pc,$*.pc)
HOST_PKG_CONFIG_PATH		=$(HOST_PATH)/lib/pkgconfig
HOST_PKG_CONFIG			=$(HOST_PATH)/bin/pkg-config

$(eval $(call template,pkg-config,host))

pkg-config.CONFIGUREFLAGS			+= --with-internal-glib
pkg-config.CFLAGS_FOR_HOST			+= -std=gnu89
pkg-config.ENVIRONMENT				+= $(cross.ENVIRONMENT)

### pkg-config does not depend on anything from the toolchain, not even binutils

pkg-config.sourcebase: pkg-config.archive_sourcebase
pkg-config.sourcetree: pkg-config.sourcebase_patched
# pkg-config.cmi_configure:
pkg-config.install: pkg-config.cmi


pkg-config.issue: pkg-config.skeleton
	$(done)


%.pkg-config_file: %.install
	$(call lHint,Generating pkg-config for $*)
	@[ ! -z "$($*.PKG_CONFIG_LIBNAME)" ] || (echo "$*.PKG_CONFIG_LIBNAME must not be empty if using target pkg-config."; exit 22);
	@#echo "Target: $(TARGET_PKG_CONFIG_FILE)"
	@mkdir -p $(TARGET_PKG_CONFIG_PATH)
	@rm -f $(TARGET_PKG_CONFIG_FILE)
	@echo "# This file was generated by CMake for $*" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "prefix=$(TARGET_PREFIX)" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "exec_prefix=\$${prefix}" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "libdir=\$${prefix}/lib" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "includedir=\$${prefix}/include" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "Name: $*" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "Description: $($*.DESCRIPTION)" >> $(TARGET_PKG_CONFIG_FILE)
	@if [ ! -z "$($*.PKG_CONFIG_VERSION)" ]; then \
		( echo "Version: $($*.PKG_CONFIG_VERSION)" >> $(TARGET_PKG_CONFIG_FILE) ); \
	else \
		( echo "Version: $($*.VERSION)" >> $(TARGET_PKG_CONFIG_FILE) ); \
	fi
	@echo "Requires: $($*.DEPENCIES)" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "Libs: -L\$${libdir} -l$($*.PKG_CONFIG_LIBNAME)" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "Libs.private: $($*.ADDITIONAL_LIBS)" >> $(TARGET_PKG_CONFIG_FILE)
	@echo "Cflags: -I\$${includedir}$($*.PKG_CONFIG_SUBINCLUDE_PATH)" >> $(TARGET_PKG_CONFIG_FILE)
	$(silentDone)


#---fin------------------------------------------------------------------------
