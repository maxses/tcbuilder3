# 2.44 has some linker issues: undefined reference to `__assert_fail'
# For ubuntu 22.04, glibc 2.41 can be used
glibc.VERSION                  = 2.43
glibc.ARCHIVE_FILE             = glibc-$(glibc.VERSION).tar.xz
glibc.ARCHIVE_URL              = $(GNU_MIRROR)/glibc/$(glibc.ARCHIVE_FILE)
glibc.ENTRY_PATH               = glibc-$(glibc.VERSION)
glibc.SOURCE_PATH              = glibc-$(glibc.VERSION)

glibc_native.VERSION             = $(glibc.VERSION)

$(eval $(call Package,glibc))

### --host=$(TARGET): otherwise glibc_headers produces crti.o files for build
### machine
glibc_both.CONFIGUREFLAGS            =	\
                                        $(target.CONFIGUREFLAGS) \
                                        --host=$(TARGET) \
                                        --prefix=$(TARGET_NONUSR_PREFIX) \
                                        --includedir=$(TARGET_PREFIX)/include \
                                        --libdir=$(TARGET_NONUSR_PREFIX)/lib \
                                        $(gcc.MULTILIB) \
                                        --enable-add-ons \
                                        --disable-profile \
                                        --without-gd \
                                        --without-cvs \
                                        --without-selinux \
                                        --enable-shared \
                                        --enable-multi-arch \
                                        --enable-obsolete-rpc \
                                        libc_cv_forced_unwind=yes \
                                        libc_cv_c_cleanup=yes \
                                        --disable-sanity-checks \
                                        --with-headers=$(TARGET_PATH)/include


glibc.CFLAGS_FOR_TARGET				+= -fno-stack-protector

# Needed on host-gcc version 9.4.0; attribute "artificial" ignored
glibc_native.CFLAGS_FOR_HOST		+= -Wno-error=attributes -O2
               -Wl,--dynamic-linker="$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib64/ld-linux-x86-64.so.2"
               
#               -Wl,--rpath="$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib64X"
#
glibc_native.LDFLAGS_FOR_HOST		+= -Wno-error=attributes -O2
               -Wl,--dynamic-linker="$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib64/ld-linux-x86-64.so.2"
               
#               -Wl,--rpath="$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib64X"


# CXX: needed in 2.29; otherwise "g++" is used for .cc files
glibc.ENVIRONMENT                       =   $(target.ENVIRONMENT) \
                                            CXX=$(CXX_FOR_TARGET)

glibc_headers.VERSION						=$(glibc.VERSION)
glibc_headers.SOURCE_PATH					=$(glibc.SOURCE_PATH)
glibc_headers.MAKE_ARGS						+=install-bootstrap-headers=yes
glibc_headers.MAKE_TARGET					=install-headers
glibc_headers.ADDITIONAL_MAKE_TARGET			=csu/subdir_lib
glibc_headers.NO_MAKE_INSTALL				=yes
glibc.CONFIGUREFLAGS                   =$(glibc_both.CONFIGUREFLAGS)
glibc_headers.CONFIGUREFLAGS				=$(glibc_both.CONFIGUREFLAGS)

### Does not apply, crosscompile is not available yet
glibc_headers.ENVIRONMENT			=$(glibc.ENVIRONMENT)

glibc_headers.GCC								=	static_gcc.issue
glibc.GCC										=	static_gcc.issue

glibc_native.ENTRY_PATH			= $(glibc.ENTRY_PATH)
glibc_native.SOURCE_PATH		= $(glibc.SOURCE_PATH)

# must not use $(host.CONFIGUREFLAGS); the prefix has to include the sysroot
# or ld.so will always search in /lib
glibc_native.CONFIGUREFLAGS				=\
														$(_host.CONFIGUREFLAGS) \
                                          --prefix=$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)

# Checks for tools like "gawk" generated by TCB
glibc_native.ENVIRONMENT		=	$(host.ENVIRONMENT) \
                                          DESTDIR=/

#-----------------------------------------------------------------------------


glibc_ports.issue: glibc.archive_obtain setup_build
	$(genericDone)


glibc.sourcetree:     glibc.sourcebase_patched
glibc.sourcebase:     glibc.archive_sourcebase
glibc.archive_sourcebase: glibc_ports.issue

glibc.configure:  $(glibc.GCC) glibc_ports.issue
glibc.cmi_predepend: glibc.sourcetree glibc_headers.issue gawk.issue

glibc_native.cmi_configure: bison.issue gawk.issue
# python-host.issue


XXglibc.issue: glibc.cmi
	@#file /$(TARGET_PREFIX)/lib/ld-2.*.so
	@# sed -i 's|$(TARGET_NONUSR_PREFIX)||g' $(TARGET_NONUSR_PREFIX)/lib/libc.so
	@# sed -i 's|$(TARGET_NONUSR_PREFIX)||g' $(TARGET_NONUSR_PREFIX)/lib/libpthread.so
	$(done)


#   Issue: the 'empty' libc.so installed by 'glibc_headers.issue' has to be
#   removed again. but we have also take car that $(glibc.GCC) already was
#   build meanwhile
glibc.rm_empty_libc.hook: $(glibc.GCC) glibc_headers.issue
	@rm -f $(TARGET_PREFIX)/lib/libc.so
	$(silentDone)

# glibc_headers.configure: glibc_headers.autoreconf

glibc_headers.cmi_configure: $(glibc_headers.GCC) glibc_ports.issue linux_headers.issue
glibc_headers.cmi_predepend: glibc.sourcetree gawk.issue
glibc.cmi_make: glibc.rm_empty_libc.hook


### The code for libc and and crt?.o is from "EGLIBC.cross-building"
glibc_headers.issue: glibc_headers.cmi glibc_headers.cmi_make_additional_target
	$(call lHint,Coping empty libc files)
	@mkdir -p $(TARGET_PATH)/lib
	@mkdir -p $(TARGET_NONUSR_PATH)/lib
	@cp \
		$(BUILD_PATH)/glibc_headers-$(glibc_headers.VERSION)/csu/crt1.o \
		$(BUILD_PATH)/glibc_headers-$(glibc_headers.VERSION)/csu/crti.o \
		$(BUILD_PATH)/glibc_headers-$(glibc_headers.VERSION)/csu/crtn.o \
		$(BUILD_PATH)/glibc_headers-$(glibc_headers.VERSION)/csu/Scrt1.o \
		$(BUILD_PATH)/glibc_headers-$(glibc_headers.VERSION)/csu/Mcrt1.o \
					 $(TARGET_PATH)/lib
	@cd $(BUILD_PATH)/$*; $(do_export) $(GCC_FOR_TARGET) \
			-nostdlib -nostartfiles -shared -x c /dev/null \
			-o $(TARGET_NONUSR_PATH)/lib/libc.so
	@[ "$(tcb.TARGET_CPU)" = "x86_64" ] && ( \
		 mkdir -p $(SYSROOT_HOST)/lib32; \
	    cd $(BUILD_PATH)/$*; $(do_export) $(GCC_FOR_TARGET) \
			-nostdlib -nostartfiles -shared -m32 -x c /dev/null \
			-o $(TARGET_NONUSR_PATH)/lib32/libc.so ) || echo "No X86" > /dev/null
	@mkdir -p $(TARGET_NONUSR_PATH)/usr/include/gnu
	@touch $(TARGET_NONUSR_PATH)/usr/include/gnu/stubs.h
	@# Ok, but that would be kernel headers, right?
	@# add include linux/limits.h to limits.h; some projects want to use PATH_MAX
	@# sed '/^#include <features.h>/a #include <linux/limits.h>' -i $(ROOTFS_PATH)$(TARGET_PREFIX)/include/limits.h
	$(done)

glibc_libc.issue: glibc.issue
	$(silentDone)

glibc_libc_headers.issue: glibc_headers.issue
	$(silentDone)
   
RUN_LDCONFIG         =@$(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/sbin/ldconfig

glibc_native.sourcetree: glibc.sourcebase_patched
# glibc_native.cmi: glibc_native.autoreconf

# The linux headers are not needed for building, but the glibc headers themself 
# may reference to the linux headers
glibc_native.issue: glibc_native.cmi linux_headers-native.issue
	@mkdir -p $(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/usr/include
	@if [ -e "$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/include" ]; then \
	   cp -rf $(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/include/*\
		$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/usr/include; fi
	@rm -rf $(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/include
	@#$(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib/ld-linux-x86-64.so.2 --help
	@echo "$(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/lib" > $(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/etc/ld.so.conf
	@echo "$(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/usr/lib" >> $(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/etc/ld.so.conf
	@echo "$(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/usr/lib64" >> $(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)/etc/ld.so.conf
	@
	@### Remove the sysroot pathes from the native .so text files. 
	@
	@p=$$(readlink -fn $(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)); \
	   sed -i $${p}/lib/libc.so \
		   -e "s|$${p}/lib/libc.so.6|/lib/libc.so.6|g" \
		   -e "s|$${p}/lib/libc_nonshared.a|/lib/libc_nonshared.a|g" \
		   -e "s|$${p}/lib/ld-linux-x86-64.so.2|/lib/ld-linux-x86-64.so.2|g"
	@p=$$(readlink -fn $(SYSROOT_HOST)/$(HOST_NONUSR_PREFIX)); \
	   sed -i $${p}/lib/libm.so \
	      -e "s|$${p}/lib/libm.so.6|/lib/libm.so.6|g" \
	      -e "s|$${p}/lib/libmvec.so.1|/lib/libmvec.so.1|g"
	@
	@
	$(RUN_LDCONFIG)
	@
	$(done)

# Just make sure no old loader is used when 
glibc_native_ld.veryclean:
	@rm -f $(INSTALLROOT_HOST)$(HOST_NONUSR_PREFIX)/lib/ld-linux-x86-64.so.2
	@# a 'clean' does not have a 'done' file

glibc_native.veryclean: glibc.veryclean glibc_native_ld.veryclean


