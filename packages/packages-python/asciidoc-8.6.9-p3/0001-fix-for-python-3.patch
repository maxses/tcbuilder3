         Lists tests to stdout.
         """
         for test in self.tests:
-            print '%d: %s%s' % (test.number, iif(test.disabled,'!'), test.title)
+            print ( '%d: %s%s' % (test.number, iif(test.disabled,'!'), test.title) )
 
 
 class Lines(list):
