 doc/asciidoc.1 |  8 ++++----
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/a2x.py b/a2x.py
index fcc556b..40b43b7 100755
--- a/a2x.py
+++ b/a2x.py
@@ -11,13 +11,13 @@ Email:     srackham@gmail.com
 
 import os
 import fnmatch
-import HTMLParser
+import html.parser
 import re
 import shutil
 import subprocess
 import sys
 import traceback
-import urlparse
+import urllib.parse
 import zipfile
 import xml.dom.minidom
 import mimetypes
@@ -217,12 +217,12 @@ def shell(cmd, raise_error=True):
     try:
         popen = subprocess.Popen(cmd, stdout=stdout, stderr=stderr,
                 shell=True, env=ENV)
-    except OSError, e:
+    except ( OSError, e ):
         die('failed: %s: %s' % (cmd, e))
     stdoutdata, stderrdata = popen.communicate()
     if OPTIONS.verbose:
-        print stdoutdata
-        print stderrdata
+        print ( stdoutdata )
+        print ( stderrdata )
     if popen.returncode != 0 and raise_error:
         die('%s returned non-zero exit status %d' % (cmd, popen.returncode))
     return (stdoutdata, stderrdata, popen.returncode)
