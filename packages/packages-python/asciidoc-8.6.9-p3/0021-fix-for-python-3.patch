diff --git a/asciidoc.py b/asciidoc.py
index 85be503..62f33ea 100755
--- a/asciidoc.py
+++ b/asciidoc.py
@@ -4619,7 +4619,7 @@ class Config:
             if s[:2] == '\\#':          # Unescape lines starting with '#'.
                 s = s[1:]
             s = s.rstrip()
-            found = reo.findall(s)
+            found = reo.findall(s.decode('utf-8'))
             if found:
                 update_section(section) # Store previous section.
                 section = found[0].lower()
